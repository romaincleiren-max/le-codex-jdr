# Public browser configuration (Supabase publishable/anon key only)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_public_anon_key

# Server only: configure these in Vercel, never prefix them with VITE_
SUPABASE_SERVICE_ROLE_KEY=your_server_service_role_key
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
APP_URL=https://le-codex-jdr.vercel.app

# Transactional receipts: verified sender/domain in Resend
RESEND_API_KEY=re_replace_me
RECEIPT_FROM_EMAIL=Le Codex <receipts@your-verified-domain.example>

# Enable only after the documented Stripe test checkout / receipt checks
PAYMENTS_ENABLED=false